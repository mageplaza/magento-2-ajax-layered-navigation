<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Wrap the product list in #layer-product-list on the BASE handle so AJAX sort/pagination
             works whether or not the page has layered-navigation filters (filter UI stays in the
             *_type_layered handle). -->
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="layer.category.products" template="Mageplaza_AjaxLayer::products.phtml"/>
        </referenceContainer>
        <move element="category.products" destination="layer.category.products"/>
    </body>
</page>
